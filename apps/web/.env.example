# Database (Neon or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# Prisma adapter (optional)
# - neon: for Neon serverless driver (recommended on Vercel)
# - pg: for node-postgres (useful for local docker Postgres)
PRISMA_ADAPTER="neon"

# App URL (used for Stripe return urls)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python engine (FastAPI) used for exports, AI generation, and CrewAI agents.
# The Next.js proxy routes forward generation requests to this backend.
# Default: http://localhost:8000/api/v1 (matches docker-compose.yml)
ENGINE_API_URL="http://localhost:8000/api/v1"
ENGINE_API_KEY=""

# Alternative env var for the Python backend URL (if set, ENGINE_API_URL takes precedence).
# This is provided for clarity; the proxy system uses ENGINE_API_URL via server/engine.ts.
# PYTHON_API_URL="http://localhost:8000/api/v1"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_FREE="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_TEAM="price_..."

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
GITHUB_ID=""
GITHUB_SECRET=""

# Dev-only auth provider (Credentials). DO NOT enable in production.
ENABLE_DEV_LOGIN="0"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="0"

# Upstash Redis (optional; for rate limiting / caching later)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Vercel Blob (required for voice-memo uploads)
# Automatically injected on Vercel when a Blob store is linked to the project.
# For local dev, create a store at https://vercel.com/dashboard/stores and copy the token.
BLOB_READ_WRITE_TOKEN=""
