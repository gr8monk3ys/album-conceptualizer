# Database (Neon or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# Prisma adapter (optional)
# - neon: for Neon serverless driver (recommended on Vercel)
# - pg: for node-postgres (useful for local docker Postgres)
PRISMA_ADAPTER="neon"

# App URL (used for Stripe return urls)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python engine (FastAPI) used for exports + agents (optional for now)
ENGINE_API_URL="http://localhost:8000/api/v1"
ENGINE_API_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_FREE="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_TEAM="price_..."
# Optional compatibility aliases used by some Vercel Stripe integrations
STRIPE_BASIC_MONTHLY_PRICE_ID=""
STRIPE_PREMIUM_MONTHLY_PRICE_ID=""

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
# Auth.js alias accepted by this app (used by some templates/integrations)
AUTH_SECRET=""
# Optional email magic-link auth (fallback when GitHub OAuth is not configured).
# If EMAIL_SERVER is empty and RESEND_API_KEY is set, the app uses Resend SMTP automatically.
EMAIL_SERVER=""
EMAIL_FROM=""
AUTH_EMAIL_FROM=""
RESEND_API_KEY=""
RESEND_FROM=""
GITHUB_ID=""
GITHUB_SECRET=""

# Dev-only auth provider (Credentials). DO NOT enable in production.
ENABLE_DEV_LOGIN="0"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="0"

# Upstash Redis (optional; for rate limiting / caching later)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
