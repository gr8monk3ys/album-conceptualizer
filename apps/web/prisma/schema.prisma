generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  workspacesOwned Workspace[] @relation("WorkspaceOwner")
  memberships WorkspaceMember[]
  albumVersionsCreated AlbumVersion[]
  albumShareLinksCreated AlbumShareLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  albums    Album[]
  subscription Subscription?
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Album {
  id            String   @id @default(cuid())
  workspaceId   String
  title         String
  artist        String?
  conceptSummary String?
  primaryGenre  String?
  centralThemes Json?
  trackCount    Int      @default(0)
  coverUrl      String?
  status        String   @default("draft")
  // Full album JSON compatible with the Python `Album` pydantic model.
  // This is the source of truth for exports + future editors.
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  songs     Song[]
  versions  AlbumVersion[]
  shareLink AlbumShareLink?
}

model Song {
  id          String   @id @default(cuid())
  albumId     String
  trackNumber Int
  title       String
  key         String?
  tempo       Int?
  narrativeSummary String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  album    Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([albumId, trackNumber])
}

model Section {
  id              String   @id @default(cuid())
  songId          String
  sectionType     String
  order           Int
  lyrics          String?
  chordProgression Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, sectionType, order])
}

model Subscription {
  id                   String   @id @default(cuid())
  workspaceId           String   @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  plan                 String   @default("free")
  status               String   @default("inactive")
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AlbumVersion {
  id              String   @id @default(cuid())
  albumId         String
  createdByUserId String
  message         String?
  // Full album JSON snapshot at the time of saving.
  data            Json
  createdAt       DateTime @default(now())

  album     Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt])
}

model AlbumShareLink {
  id              String   @id @default(cuid())
  albumId         String   @unique
  token           String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  expiresAt       DateTime?

  album     Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([token])
}
