# API Configuration
#
# The mobile app resolves its API URL from the EAS build channel
# (see src/config/env.ts). You do NOT need to set an env var for
# production or preview builds — the URL is baked in at build time.
#
# During local development, the default http://localhost:3000 is used.
# Override it here only if your local backend runs elsewhere:
#
# EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Environment mapping (configured in src/config/env.ts):
#   development → http://localhost:3000
#   preview     → https://your-app-preview.vercel.app
#   production  → https://your-app.vercel.app
