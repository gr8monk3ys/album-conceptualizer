FROM python:3.14-slim@sha256:cae66f2ef0ec51a9891263eeee7f987dacf0a9879e8aa9353d5606e0530619a5

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    fluidsynth \
    fluid-soundfont-gm && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml README.md LICENSE ./
COPY album_conceptualizer/ ./album_conceptualizer/

RUN uv pip install --system -e ".[music]" "redis>=5.0.0"

ENV AC_SOUNDFONT_PATH=/usr/share/sounds/sf2/FluidR3_GM.sf2 \
    ALBUM_CONCEPTUALIZER_STRICT_PRODUCTION=true \
    ALBUM_CONCEPTUALIZER_STORAGE_BACKEND=sqlite \
    DATA_DIR=/data \
    CACHE_DIR=/data/cache \
    OUTPUT_DIR=/data/output \
    ALBUM_CONCEPTUALIZER_STORAGE_DB=/data/album_conceptualizer.db

VOLUME ["/data"]

EXPOSE 8000

CMD ["sh", "-c", "uvicorn album_conceptualizer.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
