# Album Conceptualizer - Production Environment Template
# Copy to .env (or inject equivalent env vars through your platform).
# This profile is preconfigured for Resend SMTP.

# Core LLM keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HOOKTHEORY_API_KEY=

# API auth (required in production)
ALBUM_CONCEPTUALIZER_API_KEYS=replace-with-long-random-key

# Network and runtime safety
ALBUM_CONCEPTUALIZER_CORS_ORIGINS=https://app.example.com
ALBUM_CONCEPTUALIZER_STRICT_PRODUCTION=true
LOG_LEVEL=INFO

# Persistence
ALBUM_CONCEPTUALIZER_STORAGE_BACKEND=sqlite
ALBUM_CONCEPTUALIZER_STORAGE_DB=./data/album_conceptualizer.db

# Abuse controls
ALBUM_CONCEPTUALIZER_RATE_LIMIT_ENABLED=true
ALBUM_CONCEPTUALIZER_RATE_LIMIT_BACKEND=redis
ALBUM_CONCEPTUALIZER_RATE_LIMIT_PER_MINUTE=120
ALBUM_CONCEPTUALIZER_QUOTA_ENABLED=true
ALBUM_CONCEPTUALIZER_QUOTA_BACKEND=redis
ALBUM_CONCEPTUALIZER_QUOTA_DAILY_LIMIT=1000
ALBUM_CONCEPTUALIZER_REDIS_URL=redis://redis:6379/0

# Billing (Stripe)
ALBUM_CONCEPTUALIZER_SUBSCRIPTION_REQUIRED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALBUM_CONCEPTUALIZER_STRIPE_PRICE_ID_PRO=
ALBUM_CONCEPTUALIZER_STRIPE_PRICE_ID_TEAM=
ALBUM_CONCEPTUALIZER_BILLING_SUCCESS_URL=https://app.example.com/billing/success
ALBUM_CONCEPTUALIZER_BILLING_CANCEL_URL=https://app.example.com/billing/cancel

# Identity and onboarding
ALBUM_CONCEPTUALIZER_IDENTITY_REQUIRE_VERIFIED_EMAIL=true
ALBUM_CONCEPTUALIZER_IDENTITY_MAGIC_LINK_TTL_HOURS=24
ALBUM_CONCEPTUALIZER_IDENTITY_INVITE_TTL_HOURS=72
ALBUM_CONCEPTUALIZER_IDENTITY_DEBUG_TOKENS=false
ALBUM_CONCEPTUALIZER_IDENTITY_MAGIC_LINK_URL_TEMPLATE=https://app.example.com/auth/magic-link?token={token}
ALBUM_CONCEPTUALIZER_IDENTITY_INVITE_URL_TEMPLATE=https://app.example.com/auth/invite?token={token}

# Email delivery provider
# Supported values: outbox, noop, smtp
ALBUM_CONCEPTUALIZER_EMAIL_PROVIDER=smtp
ALBUM_CONCEPTUALIZER_EMAIL_FROM=noreply@example.com
ALBUM_CONCEPTUALIZER_EMAIL_REPLY_TO=support@example.com

# Resend SMTP profile (https://resend.com/docs/send-with-smtp)
ALBUM_CONCEPTUALIZER_SMTP_HOST=smtp.resend.com
ALBUM_CONCEPTUALIZER_SMTP_PORT=465
ALBUM_CONCEPTUALIZER_SMTP_USERNAME=resend
ALBUM_CONCEPTUALIZER_SMTP_PASSWORD=replace-with-resend-api-key
ALBUM_CONCEPTUALIZER_SMTP_USE_TLS=false
ALBUM_CONCEPTUALIZER_SMTP_USE_SSL=true
ALBUM_CONCEPTUALIZER_SMTP_TIMEOUT_SECONDS=10

# Optional telemetry
ALBUM_CONCEPTUALIZER_TELEMETRY=true
