# LLM provider keys (choose what you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HOOKTHEORY_API_KEY=

# API auth (set one or both)
ALBUM_CONCEPTUALIZER_API_KEY=
ALBUM_CONCEPTUALIZER_API_KEYS=key1,key2

# API storage and access controls
ALBUM_CONCEPTUALIZER_STORAGE_BACKEND=file
ALBUM_CONCEPTUALIZER_STORAGE_DB=./data/album_conceptualizer.db
ALBUM_CONCEPTUALIZER_CORS_ORIGINS=http://localhost:7860
ALBUM_CONCEPTUALIZER_RATE_LIMIT_ENABLED=true
ALBUM_CONCEPTUALIZER_RATE_LIMIT_BACKEND=memory
ALBUM_CONCEPTUALIZER_RATE_LIMIT_PER_MINUTE=120
ALBUM_CONCEPTUALIZER_QUOTA_ENABLED=true
ALBUM_CONCEPTUALIZER_QUOTA_BACKEND=memory
ALBUM_CONCEPTUALIZER_QUOTA_DAILY_LIMIT=1000
ALBUM_CONCEPTUALIZER_REDIS_URL=

# Observability
LOG_LEVEL=INFO

# Optional RAG persistence
CHROMA_PERSIST_DIRECTORY=./data/chroma
