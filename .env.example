# LLM provider keys (choose what you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HOOKTHEORY_API_KEY=

# API auth (set one or both)
ALBUM_CONCEPTUALIZER_API_KEY=
ALBUM_CONCEPTUALIZER_API_KEYS=key1,key2

# API storage and access controls
ALBUM_CONCEPTUALIZER_STORAGE_BACKEND=file
ALBUM_CONCEPTUALIZER_STORAGE_DB=./data/album_conceptualizer.db
ALBUM_CONCEPTUALIZER_CORS_ORIGINS=http://localhost:7860
ALBUM_CONCEPTUALIZER_STRICT_PRODUCTION=false
ALBUM_CONCEPTUALIZER_RATE_LIMIT_ENABLED=true
ALBUM_CONCEPTUALIZER_RATE_LIMIT_BACKEND=memory
ALBUM_CONCEPTUALIZER_RATE_LIMIT_PER_MINUTE=120
ALBUM_CONCEPTUALIZER_QUOTA_ENABLED=true
ALBUM_CONCEPTUALIZER_QUOTA_BACKEND=memory
ALBUM_CONCEPTUALIZER_QUOTA_DAILY_LIMIT=1000
ALBUM_CONCEPTUALIZER_REDIS_URL=
ALBUM_CONCEPTUALIZER_IDENTITY_REQUIRE_VERIFIED_EMAIL=true
ALBUM_CONCEPTUALIZER_IDENTITY_MAGIC_LINK_TTL_HOURS=24
ALBUM_CONCEPTUALIZER_IDENTITY_INVITE_TTL_HOURS=72
ALBUM_CONCEPTUALIZER_IDENTITY_DEBUG_TOKENS=false
ALBUM_CONCEPTUALIZER_IDENTITY_MAGIC_LINK_URL_TEMPLATE=http://localhost:7860/auth/magic-link?token={token}
ALBUM_CONCEPTUALIZER_IDENTITY_INVITE_URL_TEMPLATE=http://localhost:7860/auth/invite?token={token}
ALBUM_CONCEPTUALIZER_EMAIL_PROVIDER=outbox
ALBUM_CONCEPTUALIZER_EMAIL_FROM=
ALBUM_CONCEPTUALIZER_EMAIL_REPLY_TO=
ALBUM_CONCEPTUALIZER_SMTP_HOST=
ALBUM_CONCEPTUALIZER_SMTP_PORT=587
ALBUM_CONCEPTUALIZER_SMTP_USERNAME=
ALBUM_CONCEPTUALIZER_SMTP_PASSWORD=
ALBUM_CONCEPTUALIZER_SMTP_USE_TLS=true
ALBUM_CONCEPTUALIZER_SMTP_USE_SSL=false
ALBUM_CONCEPTUALIZER_SMTP_TIMEOUT_SECONDS=10

# Observability
LOG_LEVEL=INFO

# Optional RAG persistence
CHROMA_PERSIST_DIRECTORY=./data/chroma

# --- In-app music generation (optional) -------------------------------------
# Leave MUSIC_PROVIDER unset to keep in-app rendering disabled. The app builds,
# boots and serves every other route without it; /audio/generate answers 503
# with instructions, and /audio/prompt-preview still works so you can inspect
# the prompt a render would use.
#
# MUSIC_PROVIDER=replicate
# REPLICATE_API_TOKEN=            # https://replicate.com/account/api-tokens
# MUSIC_MODEL=                    # Replicate version digest; defaults to MusicGen-large.
#                                 # PIN A DIGEST -- model tags are mutable, and an
#                                 # unpinned model silently changes what renders sound like.
# MUSIC_GENERATION_TIMEOUT=420    # seconds a single render may take
# MUSIC_MAX_ACTIVE_RENDERS=3      # concurrent renders per owner
